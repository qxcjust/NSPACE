<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/nspace_content_padding">

  <TextView
      android:id="@+id/list_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/nspace_on_background"
      android:textSize="28sp"
      android:textStyle="bold" />

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/settings_search_engine"
      android:textColor="@color/nspace_on_surface"
      android:textSize="18sp" />

  <Spinner
      android:id="@+id/search_engine_spinner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp" />

  <TextView
      android:id="@+id/version_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:textColor="@color/nspace_muted"
      android:textSize="14sp" />
</LinearLayout>

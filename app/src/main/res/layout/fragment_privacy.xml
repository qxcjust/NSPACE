<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/nspace_content_padding">

  <TextView
      android:id="@+id/list_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/nspace_on_background"
      android:textSize="28sp"
      android:textStyle="bold" />

  <Button
      android:id="@+id/button_clear_history"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/privacy_clear_history"
      android:textColor="@color/white"
      app:backgroundTint="@null"
      android:background="@drawable/nspace_btn_gradient" />

  <Button
      android:id="@+id/button_clear_cookies"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/privacy_clear_cookies"
      android:textColor="@color/white"
      app:backgroundTint="@null"
      android:background="@drawable/nspace_btn_gradient" />

  <Button
      android:id="@+id/button_clear_storage"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/privacy_clear_storage"
      android:textColor="@color/white"
      app:backgroundTint="@null"
      android:background="@drawable/nspace_btn_gradient" />

  <Button
      android:id="@+id/button_clear_all"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/privacy_clear_all"
      android:textColor="@color/white"
      app:backgroundTint="@null"
      android:background="@drawable/nspace_btn_gradient" />
</LinearLayout>

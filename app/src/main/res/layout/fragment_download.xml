<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/nspace_content_padding">

  <TextView
      android:id="@+id/list_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/nspace_on_background"
      android:textSize="28sp"
      android:textStyle="bold" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:orientation="horizontal">

    <EditText
        android:id="@+id/download_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/download_url_hint"
        android:inputType="textUri"
        android:textColor="@color/nspace_on_background"
        android:textColorHint="@color/nspace_muted" />

    <Button
        android:id="@+id/button_start_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/download_start"
        android:textColor="@color/white"
        app:backgroundTint="@null"
        android:background="@drawable/nspace_btn_gradient" />

    <Button
        android:id="@+id/button_clear_downloads"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/download_clear" />
  </LinearLayout>

  <ListView
      android:id="@+id/item_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginTop="16dp"
      android:divider="@color/nspace_surface_variant"
      android:dividerHeight="1dp" />
</LinearLayout>

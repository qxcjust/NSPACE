<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder content card for "Trending" / "Play Next" rows.
     A rounded rectangle with a subtle surface colour and aspect ratio ~16:9. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="146dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/content_card_bg"
    android:clickable="true"
    android:focusable="true">

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:text="@string/content_placeholder"
      android:textColor="@color/nspace_muted"
      android:textSize="16sp" />

</FrameLayout>

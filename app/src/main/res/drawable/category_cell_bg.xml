<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Focused / selected: emerald outline, slightly lifted surface (TV DPAD). -->
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="#111A14" />
      <stroke
          android:width="2dp"
          android:color="@color/nspace_primary" />
      <corners android:radius="@dimen/nspace_card_radius" />
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="#111A14" />
      <stroke
          android:width="2dp"
          android:color="@color/nspace_primary" />
      <corners android:radius="@dimen/nspace_card_radius" />
    </shape>
  </item>
  <!-- Default card. -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/nspace_surface" />
      <stroke
          android:width="1dp"
          android:color="@color/nspace_surface_variant" />
      <corners android:radius="@dimen/nspace_card_radius" />
    </shape>
  </item>
</selector>

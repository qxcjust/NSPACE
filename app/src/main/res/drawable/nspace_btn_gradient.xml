<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Pressed: same gradient at reduced opacity (mirrors THEME-BUTTON-ACTIVE). -->
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <gradient
          android:angle="0"
          android:startColor="#80007B49"
          android:endColor="#801CDD8E" />
      <corners android:radius="@dimen/nspace_button_radius" />
    </shape>
  </item>
  <!-- Default: emerald gradient (mirrors THEME-BUTTON). -->
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:angle="0"
          android:startColor="@color/nspace_gradient_start"
          android:endColor="@color/nspace_gradient_end" />
      <corners android:radius="@dimen/nspace_button_radius" />
    </shape>
  </item>
</selector>

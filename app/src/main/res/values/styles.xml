<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Base theme: forced dark, TV-friendly, emerald accent, pill buttons.
       Parent is the non-DayNight Material theme so the dark canvas is always
       applied regardless of the device's system theme. -->
  <style name="Theme.Nspace" parent="Theme.MaterialComponents.NoActionBar">
    <item name="colorPrimary">@color/nspace_primary</item>
    <item name="colorPrimaryVariant">@color/nspace_primary_dark</item>
    <item name="colorOnPrimary">@color/white</item>
    <item name="colorSecondary">@color/nspace_accent</item>
    <item name="colorOnSecondary">@color/white</item>
    <item name="colorAccent">@color/nspace_accent</item>

    <item name="android:colorBackground">@color/nspace_background</item>
    <item name="colorSurface">@color/nspace_surface</item>
    <item name="android:windowBackground">@color/nspace_background</item>
    <item name="android:statusBarColor">@color/nspace_background</item>
    <item name="android:navigationBarColor">@color/nspace_background</item>
    <item name="android:windowFullscreen">true</item>

    <item name="android:textColorPrimary">@color/nspace_on_background</item>
    <item name="android:textColorSecondary">@color/nspace_on_surface</item>
    <item name="android:fontFamily">sans-serif</item>

    <item name="drawerArrowStyle">@style/NspaceDrawerArrow</item>

    <!-- Make plain MaterialButtons render as solid emerald pills. -->
    <item name="materialButtonStyle">@style/NspaceButton</item>
    <item name="buttonStyle">@style/NspaceButton</item>
    <item name="editTextStyle">@style/NspaceEditText</item>
  </style>

  <style name="NspaceDrawerArrow" parent="Widget.AppCompat.DrawerArrowToggle">
    <item name="color">@color/nspace_accent</item>
  </style>

  <!-- Emerald pill button (solid fallback when no gradient drawable is set). -->
  <style name="NspaceButton" parent="Widget.MaterialComponents.Button">
    <item name="backgroundTint">@color/nspace_primary</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">16sp</item>
    <item name="cornerRadius">28dp</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingStart">24dp</item>
    <item name="android:paddingEnd">24dp</item>
  </style>

  <!-- Rounded dark input field. -->
  <style name="NspaceEditText" parent="Widget.AppCompat.EditText">
    <item name="android:background">@drawable/nspace_edittext_bg</item>
    <item name="android:textColor">@color/nspace_on_background</item>
    <item name="android:textSize">16sp</item>
    <item name="android:paddingStart">18dp</item>
    <item name="android:paddingEnd">18dp</item>
    <item name="android:minHeight">52dp</item>
  </style>

  <!-- Rounded navigation drawer items. -->
  <style name="NspaceNavItem" parent="ShapeAppearance.MaterialComponents">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">12dp</item>
  </style>

  <!-- Large, DPAD-friendly list rows for TV. -->
  <style name="NspaceListRow">
    <item name="android:minHeight">64dp</item>
    <item name="android:padding">16dp</item>
    <item name="android:textColor">@color/nspace_on_surface</item>
    <item name="android:textSize">18sp</item>
  </style>
</resources>
